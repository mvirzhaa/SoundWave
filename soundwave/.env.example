# ===== Server =====
PORT=3000
# Alamat publik server (dipakai untuk redirect OAuth Google & cookie Secure bila https)
PUBLIC_URL=http://localhost:3000
# Kunci rahasia (min. 32 karakter). Kosongkan = dibuat otomatis di data/secret.key
APP_SECRET=
# Folder data (database SQLite + kunci)
DATA_DIR=./data

# ===== Akun =====
# false = tutup pendaftaran akun baru
ALLOW_REGISTRATION=true
# Batasi pendaftaran ke domain email tertentu (pisahkan koma), mis: uika-bogor.ac.id
ALLOWED_EMAIL_DOMAINS=

# ===== Google Drive (per pengguna) =====
# OAuth client tipe "Web application" dari Google Cloud Console.
# Authorized redirect URI: <PUBLIC_URL>/api/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mode "link folder": baca folder Drive publik tanpa login Google (API key dengan Google Drive API aktif)
GOOGLE_API_KEY=
# Skema deep link aplikasi mobile (harus sama dengan "scheme" di app.json)
MOBILE_SCHEME=soundwave

# ===== Genre otomatis (iTunes Search API, tanpa API key) =====
GENRE_LOOKUP=true
GENRE_LOOKUP_COUNTRY=ID

# ===== Lirik =====
# Alamat LRCLIB (biarkan default)
LRCLIB_BASE=https://lrclib.net
# false = jangan ambil subtitle YouTube sebagai sumber lirik cadangan
LYRICS_YOUTUBE=true

# ===== Konversi (yt-dlp + ffmpeg) =====
DOWNLOAD_DIR=
FILE_TTL_MIN=60
MAX_CONCURRENT_JOBS=3
MAX_DURATION_SEC=7200
SEARCH_LIMIT=16
YTDLP_PATH=
# node (default, pakai Node.js server ini) | deno | none
YTDLP_JS_RUNTIME=node
# cookies.txt bila server kena "Sign in to confirm you're not a bot"
YTDLP_COOKIES=
FFMPEG_PATH=

# ===== Jadwal sholat & Al-Qur'an =====
# API jadwal sholat Kemenag (MyQuran) dan Al-Qur'an (equran.id) — biarkan default
MYQURAN_BASE=https://api.myquran.com/v2
EQURAN_BASE=https://equran.id/api/v2
# Suara adzan bawaan: taruh data/adzan.mp3 (& data/adzan-subuh.mp3), atau isi URL agar diunduh sekali
ADZAN_URL=
ADZAN_SUBUH_URL=

# ===== Radio internet =====
# Direktori Radio Browser (biarkan default) & batas stream http yang diteruskan lewat server
RADIO_BROWSER_BASE=https://all.api.radio-browser.info
RADIO_MAX_STREAMS=20

# ===== Superadmin (panel /admin, login terpisah) =====
# Dibuat sekali saat server start bila belum ada. Atau: npm run admin -- email "sandi" "Nama"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Opsional: endpoint push (default Expo Push Service)
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
