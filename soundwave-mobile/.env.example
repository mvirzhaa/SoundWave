# Alamat server SoundWave bawaan (bisa diubah di layar Masuk → "Server").
# Alamat server produksi UIKA:
EXPO_PUBLIC_API_URL=https://vr.ti.fts.uika-bogor.ac.id/soundwave
# Saat development lokal pakai IP laptop di jaringan yang sama, contoh:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# Opsional: nama file suara adzan untuk notifikasi (harus didaftarkan di app.json → expo-notifications → sounds)
EXPO_PUBLIC_ADZAN_SOUND=
