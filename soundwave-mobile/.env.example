# Alamat server SoundWave bawaan (bisa diubah di layar Masuk → "Server").
# Saat development pakai IP laptop di jaringan yang sama, contoh:
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Opsional: nama file suara adzan untuk notifikasi (harus didaftarkan di app.json → expo-notifications → sounds)
EXPO_PUBLIC_ADZAN_SOUND=
