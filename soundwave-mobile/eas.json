{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://192.168.1.10:3000" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://soundwave.contoh.ac.id" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_API_URL": "https://soundwave.contoh.ac.id" }
    }
  }
}
