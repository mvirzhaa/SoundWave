{
  "expo": {
    "name": "SoundWave",
    "slug": "soundwave",
    "scheme": "soundwave",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070b1d",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.ac.uika.soundwave",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocationWhenInUseUsageDescription": "SoundWave memakai lokasi Anda untuk menentukan wilayah jadwal sholat dan waktu adzan."
      }
    },
    "android": {
      "package": "id.ac.uika.soundwave",
      "adaptiveIcon": {
        "backgroundColor": "#070b1d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#070b1d",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#070b1d"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": "SoundWave memakai mikrofon untuk perintah suara."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SoundWave memakai mikrofon untuk perintah suara seperti \"putarkan lagu The Corrs\".",
          "speechRecognitionPermission": "SoundWave mengubah ucapan Anda menjadi perintah untuk memutar lagu dan mengatur playlist."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ],
          "photosPermission": false,
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SoundWave memakai lokasi Anda untuk menentukan wilayah jadwal sholat dan waktu adzan.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8b6dff",
          "defaultChannel": "adzan",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
